            <div class="col-6"><div class="stat"><strong><%= autores %></strong><span class="book-meta">autores</span></div></div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
<section class="section">
  <div class="container">
    <div class="row align-items-end g-3">
