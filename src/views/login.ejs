<section class="container detail-page">
  <a class="back-link" href="/products">← Voltar ao garimpo</a>
  <div class="row justify-content-center">
    <div class="col-lg-7">
      <div id="mensagem" aria-live="polite"></div>
      <%# O formulário é enviado por fetch (public/scripts/auth.js) para POST /api/auth/login %>
      <form id="form-login" class="editor-card" data-voltar="<%= voltar %>" novalidate>
        <div class="editor-heading"><div><span class="eyebrow">SUA CONTA</span><h2>Entrar</h2></div><p>Entre para anunciar e gerenciar suas peças.</p></div>
        <div class="row g-3">
          <div class="col-12"><label class="form-label" for="email">E-mail *</label><input class="form-control" id="email" name="email" type="email" autocomplete="email" required placeholder="voce@email.com" /></div>
          <div class="col-12"><label class="form-label" for="senha">Senha *</label><input class="form-control" id="senha" name="senha" type="password" autocomplete="current-password" required /></div>
        </div>
        <div class="mt-4 d-flex flex-wrap align-items-center gap-3"><button class="btn btn-brand" type="submit">Entrar</button><a class="text-link" href="/cadastro?voltar=<%= encodeURIComponent(voltar) %>">Ainda não tenho conta <span aria-hidden="true">→</span></a></div>
      </form>
    </div>
  </div>
</section>
<script src="/scripts/auth.js"></script>
