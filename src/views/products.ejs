<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
  <h1 class="mb-0">Produtos</h1>
  <button class="btn btn-brand" type="button" data-bs-toggle="collapse" data-bs-target="#form-area">
    + Cadastrar livro
  </button>
</div>

<!-- Formulário de cadastro (POST /api/livros) -->
<div id="form-area" class="collapse mb-4">
  <form id="form-livro" class="card card-body">
    <div class="row g-3">
      <div class="col-md-6">
        <label class="form-label" for="titulo">Título *</label>
        <input class="form-control" id="titulo" name="titulo" required />
      </div>
      <div class="col-md-3">
        <label class="form-label" for="ano">Ano</label>
        <input class="form-control" id="ano" name="ano" type="number" />
      </div>
      <div class="col-md-3">
        <label class="form-label" for="exemplares">Exemplares</label>
        <input class="form-control" id="exemplares" name="exemplares" type="number" min="0" value="1" />
      </div>
      <div class="col-md-4">
        <label class="form-label" for="autor_id">Autor</label>
        <select class="form-select" id="autor_id" name="autor_id"><option value="">(sem autor)</option></select>
      </div>
      <div class="col-md-4">
        <label class="form-label" for="isbn">ISBN</label>
        <input class="form-control" id="isbn" name="isbn" />
      </div>
      <div class="col-md-4">
        <label class="form-label" for="editora">Editora</label>
        <input class="form-control" id="editora" name="editora" />
      </div>
      <div class="col-12">
        <span class="form-label d-block">Categorias</span>
        <div id="categorias-checks" class="d-flex flex-wrap gap-3"></div>
      </div>
      <div class="col-12 form-check ms-2">
        <input class="form-check-input" type="checkbox" id="disponivel" name="disponivel" checked />
        <label class="form-check-label" for="disponivel">Disponível</label>
      </div>
    </div>
    <div class="mt-3"><button class="btn btn-success" type="submit">Salvar</button></div>
  </form>
</div>

<form id="form-busca" class="input-group mb-3">
  <input class="form-control" id="busca" placeholder="Buscar por título, autor ou categoria" />
  <button class="btn btn-outline-secondary" type="submit">Buscar</button>
</form>

<div id="mensagem"></div>

<div id="container-produtos" class="row g-3"></div>

<script src="/scripts/common.js"></script>
<script src="/scripts/products.js"></script>
