<header class="site-header">
  <nav class="navbar navbar-expand-lg navbar-light">
    <div class="container">
      <a class="navbar-brand brand-lockup" href="/home" aria-label="Brechó Raiz, página inicial">
        <span class="brand-mark" aria-hidden="true">r.</span>
        <span>brechó <strong>raiz</strong><small>moda com história</small></span>
      </a>
      <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#menu" aria-controls="menu" aria-expanded="false" aria-label="Abrir menu">
        <span class="navbar-toggler-icon"></span>
      </button>
      <div class="collapse navbar-collapse" id="menu">
        <div class="navbar-nav ms-auto align-items-lg-center gap-lg-2">
          <a class="nav-link" href="/home">Início</a>
          <a class="nav-link" href="/products">Garimpar peças</a>
          <a class="nav-link" href="/about">Nossa história</a>
          <a class="nav-link" href="/contact">Contato</a>
          <%# usuario vem do middleware carregarUsuario (res.locals). Sem login, o botão leva para a página de entrar. %>
          <% if (typeof usuario !== "undefined" && usuario) { %>
            <span class="nav-link">Olá, <%= usuario.nome.split(" ")[0] %></span>
            <a class="nav-link" href="#" id="btn-sair" role="button">Sair</a>
            <a class="btn btn-brand nav-cta" href="/products#form-area">Anunciar uma peça <span aria-hidden="true">↗</span></a>
          <% } else { %>
            <a class="nav-link" href="/login">Entrar</a>
            <a class="btn btn-brand nav-cta" href="/login?voltar=%2Fproducts%23form-area">Anunciar uma peça <span aria-hidden="true">↗</span></a>
          <% } %>
        </div>
      </div>
    </div>
  </nav>
</header>
