<h1>Detalhes do Produto</h1>

<div id="mensagem"></div>

<div id="container-produto" class="container px-0"></div>

<!-- Edição (PATCH /api/produtos/:id) -->
<form id="form-editar" class="card card-body mt-4 d-none">
  <h2 class="h5">Editar produto</h2>
  <div class="row g-3">
    <div class="col-md-6">
      <label class="form-label" for="nome">Nome *</label>
      <input class="form-control" id="nome" required />
    </div>
    <div class="col-md-3">
      <label class="form-label" for="preco">Preço</label>
      <input class="form-control" id="preco" step="0.01" min="0" type="number" />
    </div>
    <div class="col-md-3">
      <label class="form-label" for="estoque">Estoque</label>
      <input class="form-control" id="estoque" type="number" min="0" />
    </div>
    <div class="col-md-4">
      <label class="form-label" for="marca_id">Marca</label>
      <select class="form-select" id="marca_id"><option value="">(sem marca)</option></select>
    </div>
    <div class="col-md-4">
      <label class="form-label" for="tamanho">Tamanho</label>
      <input class="form-control" id="tamanho" />
    </div>
    <div class="col-md-4">
      <label class="form-label" for="condicao">Condição</label>
      <input class="form-control" id="condicao" />
    </div>
    <div class="col-12">
      <span class="form-label d-block">Categorias</span>
      <div id="categorias-checks" class="d-flex flex-wrap gap-3"></div>
    </div>
    <div class="col-12 form-check ms-2">
      <input class="form-check-input" type="checkbox" id="disponivel" />
      <label class="form-check-label" for="disponivel">Disponível</label>
    </div>
  </div>
  <div class="mt-3 d-flex gap-2">
    <button class="btn btn-success" type="submit">Salvar alterações</button>
    <button class="btn btn-outline-danger" type="button" id="btn-excluir">Excluir produto</button>
  </div>
</form>

<a class="btn btn-link mt-3 px-0" href="/products">← Voltar para Produtos</a>

<script src="/scripts/common.js"></script>
<script src="/scripts/product-details.js"></script>
