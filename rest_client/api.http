# Via Extensão VS Code REST Client (Huachao Mao)
# Antes de testar: npm run db:populate  e  npm run dev

### Configurações Globais
@baseUrl = http://localhost:3000
@contentType = application/json

# ===================== Lecture001 =====================

### Endpoint "/"
GET {{baseUrl}}/

### Endpoint "/equipe"
GET {{baseUrl}}/equipe

# ===================== Board ApiN2V1 =====================

### Verifica o status do servidor
GET {{baseUrl}}/api/info
Accept: {{contentType}}

### Testa o Middleware (id correto = 42)
GET {{baseUrl}}/api/info/42
Accept: {{contentType}}

### Testa o Middleware (id inválido -> 400)
GET {{baseUrl}}/api/info/ABC
Accept: {{contentType}}

### Testa o Middleware (resposta incorreta -> 500 pelo errorHandler)
GET {{baseUrl}}/api/info/7
Accept: {{contentType}}

### Rota inexistente -> 404 (notFound)
GET {{baseUrl}}/api/rota-que-nao-existe
Accept: {{contentType}}

# ===================== Atividade N2 =====================

### Dados da página home
GET {{baseUrl}}/api/home

### Lista de produtos (produtos do banco)
GET {{baseUrl}}/api/products

### Produto por id
GET {{baseUrl}}/api/products/1

### Produto inexistente -> 404
GET {{baseUrl}}/api/products/999

# ===================== CRUD Produtos (SQLite) =====================

### GET - Todos os produtos
GET {{baseUrl}}/api/produtos

### GET - Busca por nome, marca ou categoria
GET {{baseUrl}}/api/produtos?q=zara

### GET - Produto por id
GET {{baseUrl}}/api/produtos/1

### GET - Produto inexistente -> 404
GET {{baseUrl}}/api/produtos/999

### POST - Cadastrar produto
POST {{baseUrl}}/api/produtos
Content-Type: {{contentType}}

{
    "nome": "Saia Plissada",
    "preco": 49.9,
    "disponivel": true,
    "estoque": 10
}

### POST - Cadastrar produto com marca, detalhes (1:1) e categorias (N:N)
POST {{baseUrl}}/api/produtos
Content-Type: {{contentType}}

{
    "nome": "Jaqueta Jeans Oversized",
    "preco": 120.0,
    "disponivel": true,
    "estoque": 3,
    "marca_id": 1,
    "tamanho": "GG",
    "condicao": "Seminovo",
    "categoria_ids": [1, 2]
}

### POST - Dados inválidos -> 400
POST {{baseUrl}}/api/produtos
Content-Type: {{contentType}}

{
    "preco": "mil novecentos"
}

### POST - Marca inexistente (FOREIGN KEY) -> 400
POST {{baseUrl}}/api/produtos
Content-Type: {{contentType}}

{
    "nome": "Produto com marca inválida",
    "marca_id": 999
}

### PUT - Atualizar produto COMPLETO (id = 1)
PUT {{baseUrl}}/api/produtos/1
Content-Type: {{contentType}}

{
    "nome": "Produto Atualizado",
    "preco": 99.5,
    "disponivel": false,
    "estoque": 5
}

### PATCH - Atualização PARCIAL (id = 1)
PATCH {{baseUrl}}/api/produtos/1
Content-Type: {{contentType}}

{
    "nome": "Nome Parcialmente Atualizado"
}

### N:N - Vincular a categoria 4 ao produto 2
POST {{baseUrl}}/api/produtos/2/categorias/4

### N:N - Remover o vínculo da categoria 4 com o produto 2
DELETE {{baseUrl}}/api/produtos/2/categorias/4

### DELETE - Remover produto (id = 1)
DELETE {{baseUrl}}/api/produtos/1

### DELETE - Produto inexistente -> 404
DELETE {{baseUrl}}/api/produtos/999

# ===================== Marcas (1:N) =====================

### Listar marcas
GET {{baseUrl}}/api/marcas

### Marca e seus produtos
GET {{baseUrl}}/api/marcas/3

### Cadastrar marca
POST {{baseUrl}}/api/marcas
Content-Type: {{contentType}}

{
    "nome": "Adidas"
}

### Atualizar marca
PUT {{baseUrl}}/api/marcas/4
Content-Type: {{contentType}}

{
    "nome": "Adidas Originals"
}

### Deletar marca (os produtos ficam com marca_id = NULL - ON DELETE SET NULL)
DELETE {{baseUrl}}/api/marcas/3

# ===================== Categorias (N:N) =====================

### Listar categorias
GET {{baseUrl}}/api/categorias

### Categoria e seus produtos
GET {{baseUrl}}/api/categorias/2

### Cadastrar categoria
POST {{baseUrl}}/api/categorias
Content-Type: {{contentType}}

{
    "nome": "Acessórios"
}

### Atualizar categoria
PUT {{baseUrl}}/api/categorias/5
Content-Type: {{contentType}}

{
    "nome": "Acessórios Femininos"
}

### Deletar categoria (vínculos removidos por ON DELETE CASCADE)
DELETE {{baseUrl}}/api/categorias/5

# ===================== Usuários =====================

### Listar usuários
GET {{baseUrl}}/api/usuarios

### Usuário por id
GET {{baseUrl}}/api/usuarios/1

### Cadastrar usuário
POST {{baseUrl}}/api/usuarios
Content-Type: {{contentType}}

{
    "nome": "Maria Souza",
    "email": "maria@email.com",
    "idade": 20,
    "altura": 1.62,
    "ativo": true,
    "saldo": 100
}

### E-mail repetido (UNIQUE) -> 400
POST {{baseUrl}}/api/usuarios
Content-Type: {{contentType}}

{
    "nome": "Outro José",
    "email": "ze@email.com"
}

### Deletar usuário
DELETE {{baseUrl}}/api/usuarios/2
